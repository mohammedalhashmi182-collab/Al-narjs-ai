# Database
DATABASE_URL=sqlite+aiosqlite:///ai_agent_system.db
DB_USER=ai_agents
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=deepseek-r1
OLLAMA_TIMEOUT=120.0
OLLAMA_MAX_CONNECTIONS=10

# External APIs (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.1-70b-versatile

ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# Code Executor
CODE_EXECUTOR_TIMEOUT=30

# Security
SECRET_KEY=generate-with-openssl-rand-base64-32
# Owner dashboard gate — must be set, no built-in default
OWNER_PASSWORD=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
ENVIRONMENT=development
TIMEZONE=UTC
LOG_LEVEL=INFO
LOG_JSON=false

# Scheduler
SCHEDULER_TIMEZONE=UTC
SCHEDULER_MAX_INSTANCES=1

# Queue Worker
QUEUE_WORKER_CONCURRENCY=4
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=5.0

# CORS
CORS_ORIGINS=https://karmaai.online,https://www.karmaai.online,http://localhost:3000,http://localhost:8000

# Domain
DOMAIN=karmaai.online
WWW_DOMAIN=www.karmaai.online

# Payments
# PayPal (international checkout) — get keys from https://developer.paypal.com/dashboard
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox           # sandbox | live
PAYPAL_CURRENCY=SAR
PAYPAL_WEBHOOK_ID=
# KSA VAT
VAT_RATE=0.15

# Customer acquisition (Karma AI lead system)
# --- Support channels ---
# Telegram is the public channel (t.me/AlNarjs7BOT). WhatsApp Cloud API is
# registered as a second, owner-enabled channel: it stays inert until a valid
# Meta token (EAA..., never a dialog key or app id|secret pair) is present.
# Verify credentials with: python scripts/verify_whatsapp_credentials.py
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_DAILY_AUTO_LIMIT=
WHATSAPP_LEAD_COOLDOWN_HOURS=
LEADS_EXCEL_PATH=
SALES_CAMPAIGN_SIZE=200

# Email (SMTP) — optional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
MAIL_REPLY_TO=