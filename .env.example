# Database
DATABASE_URL=sqlite+aiosqlite:///ai_agent_system.db
DB_USER=ai_agents
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=deepseek-r1
OLLAMA_TIMEOUT=120.0
OLLAMA_MAX_CONNECTIONS=10

# External APIs (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.1-70b-versatile

ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# Code Executor
CODE_EXECUTOR_TIMEOUT=30

# Security
SECRET_KEY=generate-with-openssl-rand-base64-32
# Owner dashboard gate — must be set, no built-in default
OWNER_PASSWORD=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
ENVIRONMENT=development
TIMEZONE=UTC
LOG_LEVEL=INFO
LOG_JSON=false

# Scheduler
SCHEDULER_TIMEZONE=UTC
SCHEDULER_MAX_INSTANCES=1

# Queue Worker
QUEUE_WORKER_CONCURRENCY=4
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=5.0

# CORS
CORS_ORIGINS=https://karmaai.online,https://www.karmaai.online,http://localhost:3000,http://localhost:8000

# Domain
DOMAIN=karmaai.online
WWW_DOMAIN=www.karmaai.online

# Payments
# PayPal (international checkout) — get keys from https://developer.paypal.com/dashboard
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox           # sandbox | live
PAYPAL_CURRENCY=SAR
PAYPAL_WEBHOOK_ID=
# KSA VAT
VAT_RATE=0.15

# Customer acquisition (Karma AI lead system)
# --- Support channels ---
# Telegram is the public channel (t.me/AlNarjs7BOT). WhatsApp Cloud API is
# registered as a second, owner-enabled channel: it stays inert until a valid
# Meta token (EAA..., never a dialog key or app id|secret pair) is present.
# Verify credentials with: python scripts/verify_whatsapp_credentials.py
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_DAILY_AUTO_LIMIT=
WHATSAPP_LEAD_COOLDOWN_HOURS=
LEADS_EXCEL_PATH=
SALES_CAMPAIGN_SIZE=200

# Analytics — Meta Pixel (public client-side identifier, safe to commit)
# The default in src/config/settings.py is the production Pixel; set this only
# to point a different environment at another Pixel.
META_PIXEL_ID=1097204086820069
# Google tag — leave empty to load nothing
GTAG_ID=

# Email (SMTP) — optional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
MAIL_REPLY_TO=
# Site assistant customer-service handoff is the company phone 0540799266
# (src/services/support.py). SUPPORT_PHONE / SUPPORT_CHANNEL are no longer read.

# LLM router (/api/ai/ask) — src/ai/. Keys from env only. Never commit values.
# GROQ_API_KEY (above, if set) is the fast model. DEEP_MODEL_KEY is the stronger
# model (any OpenAI-compatible endpoint). Retrieval uses the pgvector RAG, not Qdrant.
DEEP_MODEL_KEY=
DEEP_MODEL_BASE_URL=
DEEP_MODEL_NAME=

# CF-Connecting-IP is the visitor only when the connecting address is inside
# Cloudflare's published ranges (bundled in src/utils/net.py, from
# https://www.cloudflare.com/ips-v4 and https://www.cloudflare.com/ips-v6).
# CLOUDFLARE_IP_RANGES replaces that snapshot: comma-separated CIDRs.
# CLOUDFLARE_IP_RANGES=
# Otherwise TRUSTED_PROXY_HOPS is how many proxies append X-Forwarded-For
# (Render is 1: the right-most hop). 0 ignores the header and uses the peer.
# A header shorter than the hop count is ignored.
# Store webhooks and the public AI limit share this rule via src/utils/net.py.
TRUSTED_PROXY_HOPS=1

# Customer payment methods besides Moyasar. Both default off.
# Set to 1 only to re-enable the existing code paths.
CUSTOMER_PAYPAL_ENABLED=
CUSTOMER_BANK_TRANSFER_ENABLED=

# --- RAG (tenant reply agent + site assistant) ---
# auto | openai | gemini | local | hash   (auto: OpenAI key → Gemini key → sentence-transformers → hash)
RAG_EMBED_PROVIDER=auto
# RAG_EMBED_MODEL=text-embedding-3-small   # or gemini-embedding-001 / intfloat/multilingual-e5-small
# RAG_MIN_CONFIDENCE=0.42                   # below → human handoff
# RAG_OVER_LIMIT=extractive                 # over the plan's conversation limit: extractive | handoff (no paid AI calls either way)

# Salla / Zid — multi-tenant store tools for a merchant's own bot.
# Default OFF. Public copy stays «قريباً» until the owner sets this to true
# AND replaces that copy in a separate change.
# Salla: https://docs.salla.dev/authorization  https://docs.salla.dev/webhooks
# Zid:   https://docs.zid.sa/authorization     https://docs.zid.sa/create-a-webhook
# Redirect URLs must match the partner dashboards exactly.
# Zid store webhooks are HTTP Basic (user "narjis", password ZID_WEBHOOK_SECRET):
# https://docs.zid.sa/create-a-webhook
# App events use a dashboard header, read here as X-Zid-Webhook-Token.
# Neither binds the body. They are accepted only when ZID_WEBHOOK_ALLOW_UNSIGNED
# is true. If X-Zid-Signature is present it must be HMAC-SHA256 of the raw body
# and the unsigned fallback is not used.
# Both platforms reject a missing or stale timestamp (STORE_WEBHOOK_MAX_AGE_SECONDS).
# Salla's created_at is inside the HMAC. Unsigned Zid may send X-Zid-Timestamp;
# that header is not bound to the body.
# STORE_TOKEN_ENC_KEY is required. The flag does nothing without it. There is
# no derivation from SECRET_KEY. Generate a Fernet key locally and put it only
# in Render:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Ciphertext is v1.<STORE_TOKEN_ENC_KEY_ID>.<token>. To rotate, set the new
# key and id here and list the old pair in STORE_TOKEN_ENC_PREVIOUS_KEYS
# (comma-separated id:key, decrypt only). Rotating SECRET_KEY does not rotate
# store tokens.
# Client address is src.utils.net.client_ip. TRUSTED_PROXY_HOPS is set above.
# Alembic revision 0012 revises 0011.
STORE_INTEGRATIONS_ENABLED=false
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_WEBHOOK_SECRET=
SALLA_REDIRECT_URI=https://karmaai.online/webhooks/stores/salla/callback
ZID_CLIENT_ID=
ZID_CLIENT_SECRET=
ZID_WEBHOOK_SECRET=
ZID_REDIRECT_URI=https://karmaai.online/webhooks/stores/zid/callback
STORE_TOKEN_ENC_KEY=
STORE_TOKEN_ENC_KEY_ID=1
STORE_TOKEN_ENC_PREVIOUS_KEYS=
ZID_WEBHOOK_ALLOW_UNSIGNED=false
STORE_WEBHOOK_MAX_AGE_SECONDS=900
